### Clear globals before re-running from a clean DB
### Tools > HTTP Client > Clear Cookies & Clear Global Variables

### health
GET http://localhost:4200/api/health
X-Jat-Client-Type: web-client

### initialized
GET http://localhost:4200/api/initialized
X-Jat-Client-Type: web-client

### Doesn't exist
GET http://localhost:4200/api/doesnt_exist
X-Jat-Client-Type: web-client

### Register user1
POST http://localhost:4200/api/users
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "email": "user1@example.com",
    "password": "password123",
    "username": "user1"
}

> {%
    client.global.set("user1Id", response.body.data.user_id);
%}

### Register user2
POST http://localhost:4200/api/users
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "email": "user2@example.com",
    "password": "password123",
    "username": "user2"
}

> {%
    client.global.set("user2Id", response.body.data.user_id);
%}

### Login user1 (web-client sets cookies automatically)
POST http://localhost:4200/api/auth/login
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "email": "user1@example.com",
    "password": "password123"
}

### Get user1 data
GET http://localhost:4200/api/users/{{user1Id}}
X-Jat-Client-Type: web-client

### Update user1
PUT http://localhost:4200/api/users
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "username": "user1_updated",
    "email": "user1_updated@example.com"
}

### List application statuses (seeded defaults)
GET http://localhost:4200/api/application_statuses
X-Jat-Client-Type: web-client

> {%
    const statuses = response.body.data;
    const applied = statuses.find(s => s.status === "Applied");
    client.global.set("appliedStatusId", applied ? applied.id : statuses[0].id);
%}

### Create custom application status
POST http://localhost:4200/api/application_statuses
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "status": "Custom Status",
    "kind": "applied"
}

> {%
    client.global.set("customStatusId", response.body.data.id);
%}

### Get custom status
GET http://localhost:4200/api/application_statuses/{{customStatusId}}
X-Jat-Client-Type: web-client

### Update custom status
PUT http://localhost:4200/api/application_statuses/{{customStatusId}}
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "status": "Updated Custom Status",
    "kind": "applied"
}

### Delete custom status
DELETE http://localhost:4200/api/application_statuses/{{customStatusId}}
X-Jat-Client-Type: web-client

### Create company
POST http://localhost:4200/api/company
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "name": "Acme Corp",
    "website": "https://acme.example.com"
}

> {%
    client.global.set("companyId", response.body.data.id);
%}

### List companies
GET http://localhost:4200/api/company
X-Jat-Client-Type: web-client

### Get company
GET http://localhost:4200/api/company/{{companyId}}
X-Jat-Client-Type: web-client

### Update company
PUT http://localhost:4200/api/company/{{companyId}}
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "name": "Acme Corp Updated",
    "website": "https://acme-updated.example.com"
}

### Create job application
POST http://localhost:4200/api/jobs
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "title": "Backend Engineer",
    "url": "https://acme-updated.example.com/jobs/backend",
    "status_id": {{appliedStatusId}},
    "company_id": {{companyId}}
}

> {%
    client.global.set("jobId", response.body.data.id);
%}

### List job applications
GET http://localhost:4200/api/jobs
X-Jat-Client-Type: web-client

### Get job application
GET http://localhost:4200/api/jobs/{{jobId}}
X-Jat-Client-Type: web-client

### Update job application status
PUT http://localhost:4200/api/jobs/{{jobId}}/status/{{appliedStatusId}}
X-Jat-Client-Type: web-client

### Create job note
POST http://localhost:4200/api/jobs/{{jobId}}/notes
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "body": "Submitted application, waiting for response"
}

> {%
    client.global.set("noteId", response.body.data.id);
%}

### List job notes
GET http://localhost:4200/api/jobs/{{jobId}}/notes
X-Jat-Client-Type: web-client

### Get job note
GET http://localhost:4200/api/jobs/{{jobId}}/notes/{{noteId}}
X-Jat-Client-Type: web-client

### Update job note
PUT http://localhost:4200/api/jobs/{{jobId}}/notes/{{noteId}}
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "body": "Updated note content"
}

### Delete job note
DELETE http://localhost:4200/api/jobs/{{jobId}}/notes/{{noteId}}
X-Jat-Client-Type: web-client

### Delete job application
DELETE http://localhost:4200/api/jobs/{{jobId}}
X-Jat-Client-Type: web-client

### Create second job for authorization cross-check
POST http://localhost:4200/api/jobs
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "title": "Authorization Test Job",
    "url": "https://auth-test.example.com",
    "status_id": {{appliedStatusId}},
    "company_id": {{companyId}}
}

> {%
    client.global.set("user1PrivateJobId", response.body.data.id);
%}

### Login user2
POST http://localhost:4200/api/auth/login
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "email": "user2@example.com",
    "password": "password123"
}

### Cross-user: user2 tries to read user1's job (expect 403)
GET http://localhost:4200/api/jobs/{{user1PrivateJobId}}
X-Jat-Client-Type: web-client

### Cross-user: user2 reads global company (expect 200)
GET http://localhost:4200/api/company/{{companyId}}
X-Jat-Client-Type: web-client

### Refresh token (uses refresh_token cookie)
GET http://localhost:4200/api/auth/refresh_token
X-Jat-Client-Type: web-client

### Revoke token (uses refresh_token cookie)
GET http://localhost:4200/api/auth/revoke_token
X-Jat-Client-Type: web-client

### Logout (uses refresh_token cookie)
POST http://localhost:4200/api/auth/logout
X-Jat-Client-Type: web-client

### Attempt protected request after logout (expect 401)
GET http://localhost:4200/api/jobs
X-Jat-Client-Type: web-client

###
### ADMIN SECTION
### Run this in psql before executing the requests below:
### UPDATE users SET is_admin = true WHERE email = 'user2@example.com';
###

### Login user2 after promoting to admin
POST http://localhost:4200/api/auth/login
X-Jat-Client-Type: web-client
Content-Type: application/json

{
    "email": "user2@example.com",
    "password": "password123"
}

### Admin: list all users
GET http://localhost:4200/api/admin/users
X-Jat-Client-Type: web-client

### Admin: promote user1 to admin
GET http://localhost:4200/api/admin/users/{{user1Id}}
X-Jat-Client-Type: web-client

### Admin: demote user1
DELETE http://localhost:4200/api/admin/users/{{user1Id}}
X-Jat-Client-Type: web-client

### Admin: delete company
DELETE http://localhost:4200/api/company/{{companyId}}
X-Jat-Client-Type: web-client

### Set server initialized
GET http://localhost:4200/api/initialized/set
X-Jat-Client-Type: web-client
